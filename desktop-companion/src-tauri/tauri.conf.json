{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rub Minds Backroom Companion",
  "version": "0.1.0",
  "identifier": "com.rubminds.backroom.companion",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run dev:desktop-companion",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "cd ../.. && npm run build:desktop-companion",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.supabase.in wss://*.supabase.in; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    },
    "windows": [
      {
        "label": "main",
        "title": "Rub Minds Backroom Companion",
        "width": 760,
        "height": 900,
        "minWidth": 620,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Securely connect your actual computer to Rub Minds Backroom",
    "category": "Productivity"
  },
  "plugins": {}
}
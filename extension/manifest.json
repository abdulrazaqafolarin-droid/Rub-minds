{
  "manifest_version": 3,
  "name": "Rub Minds — AI Collaboration",
  "version": "0.1.0",
  "description": "Bring your existing ChatGPT or Claude conversation into a manually controlled Rub Minds collaboration loop.",
  "action": {
    "default_title": "Rub Minds",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content/rub-minds-continuation.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
